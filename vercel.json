{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vue",
      "installCommand": "yarn install --frozen-lockfile --non-interactive",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend/",
      "runtime": "node",
      "entrypoint": "main.js",
      "installCommand": "npm ci",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build",
      "functions": {
        "main.js": { "maxDuration": 300 }
      }
    }
  },
  "rewrites": [
    { "source": "/socket.io/", "destination": { "service": "backend" } },
    { "source": "/socket.io/:path*", "destination": { "service": "backend" } },
    { "source": "/auth/:path*", "destination": { "service": "backend" } },
    { "source": "/user/:path*", "destination": { "service": "backend" } },
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
