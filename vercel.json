{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vue",
      "installCommand": "yarn install --frozen-lockfile --non-interactive",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "runtime": "node",
      "entrypoint": "main.js",
      "installCommand": "npm ci",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build && npm run verify:preview",
      "functions": {
        "main.js": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/socket.io/",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/user/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://notion.so https://*.notion.so https://notion.site https://*.notion.site https://notion.com https://*.notion.com"
        }
      ]
    }
  ]
}
