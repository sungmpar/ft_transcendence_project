+            await watcher.get_by_test_id('online-status').filter(has_text='연결이 끊').wait_for(timeout=20000)
+            row['faultTiming']['clientDisconnectedVisibleAtMs'] = await watcher.evaluate('performance.now()')
+            await asyncio.sleep(0.8)
