+    state.tick = 7;
+    expect(ai.sample(state).action).toBe(false);
+  });
+
+  it('rearms Power after a delayed request is rejected during a point transition', () => {
+    const ai = createAiController('right', 'hard', () => 0.5);
+    const rng = createSeededRng(1);
