# Values are examples only. Put real secrets in Vercel Preview settings, not Git.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@YOUR-UPSTASH-HOST:6379
SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
BLOB_READ_WRITE_TOKEN=
ENABLE_GUEST_LOGIN=true
DEFAULT_IMG=/default.jpeg
# Optional. All three are necessary for real 42 OAuth.
CLIENT_UID=
CLIENT_SEC=
CALLBACK=https://YOUR-APP-DOMAIN/auth/42/redirect
# Gmail app-specific SMTP credential. Never use your Google login password.
EMAIL_USER=
EMAIL_PW=
# Guest admission budgets shared across instances and deployment aliases.
GUEST_IP_LIMIT=10
GUEST_IP_WINDOW_SECONDS=3600
GUEST_GLOBAL_LIMIT=100
GUEST_GLOBAL_WINDOW_SECONDS=86400
# Manual read-only verification, disabled by default.
VERIFY_PREVIEW_DB=false
VERIFY_PREVIEW_MATCH_IDS=6,7
