{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "watchman": false,
  "testMatch": [
    "<rootDir>/src/game/server-match-runner.spec.ts",
    "<rootDir>/src/game/game-session.spec.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      { "tsconfig": { "target": "es2019", "esModuleInterop": true } }
    ]
  },
  "moduleNameMapper": { "^src/(.*)$": "<rootDir>/src/$1" }
}
