{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "watchman": false,
  "testMatch": ["<rootDir>/src/game/core.spec.ts", "<rootDir>/src/game/protocol.spec.ts", "<rootDir>/src/game/ai.spec.ts"],
  "transform": {"^.+\\.ts$": ["ts-jest", {"tsconfig": {"target": "es2019", "strict": true, "esModuleInterop": true}}]},
  "moduleNameMapper": {"^src/(.*)$": "<rootDir>/src/$1"}
}
